### Key Implementation Details

**Global Ctrl+B in keyboard-shortcuts.service.ts:**
```typescript
constructor(private router: Router, private dialog: MatDialog) {
  this.registerDefaultShortcuts()
  if (typeof window !== 'undefined') {
    window.addEventListener('keydown', this.handleKeyDown.bind(this))
  }
}

private handleKeyDown(event: KeyboardEvent): void {
  if (event.ctrlKey && event.key === 'b') {
    event.preventDefault()
    if (this.leftPanelToggleCallback) {
      this.leftPanelToggleCallback()
    }
  }
}
```

**Ctrl+Shift+R in app.ts:**
```typescript
this.keyboardShortcutsService.registerActionCallback('runProjectPipelines', () => {
  const projectId = this.projectContext.getProjectId()
  const pipelineId = this.projectContext.getSelectedPipelineId()
  if (projectId && pipelineId) {
    const url = `/runpipelines?pipelineId=${pipelineId}&projectId=${projectId}`
    window.open(url, '_blank')
  }
})
```

